generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id           Int       @id @default(autoincrement())
  partNumber   String    @unique
  manufacturer String
  description  String?
  categoryId   Int?
  datasheet    String?
  packageType  String?
  mountType    String?
  status       String    @default("active")
  minPrice     Float?
  stock        Int       @default(0)
  moq          Int       @default(1)
  leadTime     String?
  specs        String?
  imageUrl     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  category     Category? @relation(fields: [categoryId], references: [id])

  @@index([manufacturer])
  @@index([categoryId])
  @@index([status])
}

model Category {
  id        Int        @id @default(autoincrement())
  name      String
  slug      String     @unique
  parentId  Int?
  icon      String?
  seoTitle  String?
  seoDesc   String?
  sortOrder Int        @default(0)
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  products  Product[]

  @@index([parentId])
  @@index([slug])
}

model Manufacturer {
  id      Int     @id @default(autoincrement())
  name    String  @unique
  slug    String  @unique
  logo    String?
  website String?
  country String?

  @@index([slug])
}

model RfqSubmission {
  id            Int       @id @default(autoincrement())
  name          String
  email         String
  company       String?
  phone         String?
  country       String?
  message       String?
  parts         String
  bomFile       String?
  bomFileName   String?
  status        String    @default("new")
  notes         String?
  ipAddress     String?
  userAgent     String?
  trackingData  String?
  sourceChannel String?
  landingPage   String?
  submittedAt   DateTime  @default(now())
  processedAt   DateTime?

  @@index([status])
  @@index([email])
  @@index([submittedAt])
  @@index([sourceChannel])
}

model AdminSetting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String

  @@index([key])
}

model BlogPost {
  id              Int           @id @default(autoincrement())
  title           String
  slug            String        @unique
  excerpt         String?
  content         String
  coverImage      String?
  status          String        @default("draft")
  publishedAt     DateTime?
  author          String        @default("FPGACenter Team")
  categoryId      Int?
  tags            String?
  seoTitle        String?
  seoDesc         String?
  seoKeywords     String?
  relatedProducts String?
  viewCount       Int           @default(0)
  readingTime     Int?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  category        BlogCategory? @relation(fields: [categoryId], references: [id])

  @@index([status])
  @@index([categoryId])
  @@index([publishedAt])
  @@index([slug])
}

model BlogCategory {
  id    Int        @id @default(autoincrement())
  name  String     @unique
  slug  String     @unique
  posts BlogPost[]

  @@index([slug])
}

model AdminUser {
  id          Int       @id @default(autoincrement())
  email       String    @unique
  password    String
  name        String
  role        String    @default("editor")
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([email])
  @@index([role])
}

model ContactSubmission {
  id          Int       @id @default(autoincrement())
  name        String
  email       String
  company     String?
  phone       String?
  subject     String
  message     String
  status      String    @default("new")
  notes       String?
  ipAddress   String?
  submittedAt DateTime  @default(now())

  @@index([status])
  @@index([email])
  @@index([submittedAt])
}

