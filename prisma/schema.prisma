generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

model Product {
  id           Int       @id @default(autoincrement())
  partNumber   String    @unique
  manufacturer String
  description  String?
  categoryId   Int?
  datasheet    String?
  packageType  String?
  mountType    String?
  status       String    @default("active")
  minPrice     Float?
  stock        Int       @default(0)
  moq          Int       @default(1)
  leadTime     String?
  specs        String?
  imageUrl      String?
  qualityScore  Int       @default(0)
  indexable     Boolean   @default(false)
  // Precomputed "is this an FPGA/CPLD-adjacent part" flag. Derived offline by
  // scripts/flag-programmable-logic.mjs (run after bulk product imports) from
  // the predicate in src/lib/fpga-series-data.js. Lets the homepage rotation
  // filter on an indexed boolean instead of a 30-branch ILIKE OR per request.
  isProgrammableLogic Boolean @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  category     Category? @relation(fields: [categoryId], references: [id])

  @@index([manufacturer])
  @@index([categoryId])
  @@index([status])
  @@index([qualityScore])
  @@index([indexable])
  // Composite indexes for the hot read paths at 700K+ rows:
  // - related-products / same-manufacturer widgets sort by stock
  // - category and manufacturer listings sort by partNumber
  // - sitemap lastmod queries sort indexable rows by updatedAt
  // - 404 page popular-parts widget filters status + sorts stock
  @@index([categoryId, stock])
  @@index([manufacturer, stock])
  @@index([categoryId, partNumber])
  @@index([manufacturer, partNumber])
  @@index([indexable, updatedAt])
  @@index([status, stock])
  @@index([isProgrammableLogic, stock])
  // Trigram GIN indexes power ILIKE '%q%' search. They MUST be declared here:
  // `prisma db push` drops any index it doesn't know about, which is exactly
  // how these got silently dropped once. scripts/add-search-indexes.mjs
  // creates them CONCURRENTLY (no write lock) with matching names for
  // first-time production rollout.
  @@index([partNumber(ops: raw("gin_trgm_ops"))], type: Gin, map: "Product_partNumber_trgm_idx")
  @@index([manufacturer(ops: raw("gin_trgm_ops"))], type: Gin, map: "Product_manufacturer_trgm_idx")
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, map: "Product_description_trgm_idx")
}

model Category {
  id        Int        @id @default(autoincrement())
  name      String
  slug      String     @unique
  parentId  Int?
  icon      String?
  seoTitle  String?
  seoDesc   String?
  sortOrder Int        @default(0)
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  products  Product[]

  @@index([parentId])
  @@index([slug])
}

model Manufacturer {
  id            Int     @id @default(autoincrement())
  name          String  @unique
  slug          String  @unique
  logo          String?
  website       String?
  country       String?
  description   String?
  specialties   String?   // JSON array: ["Power Management", "MCUs", ...]
  founded       String?
  headquarters  String?
  stockNote     String?   // Sourcing note for this brand at FPGACenter

  @@index([slug])
}

model RfqSubmission {
  id            Int       @id @default(autoincrement())
  name          String
  email         String
  company       String?
  phone         String?
  country       String?
  message       String?
  parts         String
  status        String    @default("new")
  notes         String?
  ipAddress     String?
  userAgent     String?
  submittedAt   DateTime  @default(now())
  processedAt   DateTime?
  landingPage   String?
  sourceChannel String?
  trackingData  String?
  bomFile       String?
  bomFileName   String?

  @@index([status])
  @@index([email])
  @@index([submittedAt])
  @@index([sourceChannel])
}

model AdminSetting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String

  @@index([key])
}

model BlogPost {
  id              Int           @id @default(autoincrement())
  title           String
  slug            String        @unique
  excerpt         String?
  content         String
  coverImage      String?
  status          String        @default("draft")
  publishedAt     DateTime?
  author          String        @default("FPGACenter Team")
  categoryId      Int?
  tags            String?
  seoTitle        String?
  seoDesc         String?
  seoKeywords     String?
  relatedProducts String?
  viewCount       Int           @default(0)
  readingTime     Int?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  category        BlogCategory? @relation(fields: [categoryId], references: [id])

  @@index([status])
  @@index([categoryId])
  @@index([publishedAt])
  @@index([slug])
}

model BlogCategory {
  id    Int        @id @default(autoincrement())
  name  String     @unique
  slug  String     @unique
  posts BlogPost[]

  @@index([slug])
}

model AdminUser {
  id          Int       @id @default(autoincrement())
  email       String    @unique
  password    String
  name        String
  role        String    @default("editor")
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([email])
  @@index([role])
}

model ContactSubmission {
  id          Int      @id @default(autoincrement())
  name        String
  email       String
  company     String?
  phone       String?
  subject     String
  message     String
  status      String   @default("new")
  notes       String?
  ipAddress   String?
  submittedAt DateTime @default(now())

  @@index([status])
  @@index([email])
  @@index([submittedAt])
}
